# Copy to .env (in HW 4/ or any parent folder) and fill in. Never commit .env.

# Required: Portkey API key used for the gpt5.6-luna model calls
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown)
# MODEL_NAME=gpt5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# REASONING_EFFORT=low          # none | low | medium | high
# CC_SESSION_SECRET=change-me   # signs login cookies; if unset, backend/.session_secret is generated
# PORTKEY_CACHE_REFRESH=1       # benchmarks only: bypass Portkey's response cache
